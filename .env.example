# ---- Azure AI Foundry ------------------------------------------------------------------------
# Foundry portal -> your project -> Overview -> "Azure AI Foundry project endpoint"
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
# Name of a chat model deployment in that project (gpt-4o / gpt-4.1 / gpt-4o-mini ...)
MODEL_DEPLOYMENT_NAME=gpt-4o
# Auth uses DefaultAzureCredential -> run `az login` first (needs the "Azure AI User" role on the project)

# ---- Mode ---------------------------------------------------------------------------------------
# true = deterministic mock LLM (no Azure calls). Defaults to true when PROJECT_ENDPOINT is unset.
USE_MOCK_LLM=false
AGENT_RUN_TIMEOUT_S=120

# ---- Tracing ------------------------------------------------------------------------------------
# Export OpenTelemetry spans to the Application Insights resource connected to the Foundry project
# (shows up in Foundry portal -> Tracing). Connection string is auto-discovered from the project if
# APPLICATIONINSIGHTS_CONNECTION_STRING is not set.
ENABLE_TRACING=false
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Print spans to the console as well
OTEL_CONSOLE_EXPORTER=false

# ---- Demo ---------------------------------------------------------------------------------------
# TRIAGE_AS_OF=2026-09-28
# INJECT_FAULTS=bad_json,hallucination,agent_timeout,tool_timeout
